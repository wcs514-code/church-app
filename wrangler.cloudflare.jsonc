{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yan-king-attendance",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yan-king-attendance-db",
      "database_id": "689ba9f0-edfd-4b5e-901b-d18958b898ad",
      "migrations_dir": "./drizzle"
    }
  ],
  "workers_dev": true,
  "preview_urls": false
}
